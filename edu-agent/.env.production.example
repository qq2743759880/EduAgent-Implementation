# ============================================================
# EduAgent 生产环境变量模板（部署到服务器前复制为 .env 并逐项替换）
# 使用：cp .env.production.example .env && 编辑必填项
# ============================================================

# ---------- 应用（生产 DEBUG 必须为 false） ----------
APP_NAME=EduAgent
APP_VERSION=0.3.0
DEBUG=false

# CORS 允许来源（逗号分隔，必须填你的前端域名）
CORS_ORIGINS=https://edu.example.com,https://admin.example.com

# ---------- 鉴权（生产必填，禁止默认值） ----------
# 生成强随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<REPLACE_WITH_64_HEX>
JWT_ALGORITHM=HS256
# access_token 有效期（分钟），默认 24h；refresh 滑动 7 天
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 内部 API 占位 Token（管理后台脚本调用用），生成随机值
API_TOKEN=<REPLACE_WITH_RANDOM_TOKEN>

# ---------- MySQL（生产用独立账号，禁止 root/弱密码） ----------
MYSQL_HOST=db-mysql
MYSQL_PORT=3306
MYSQL_USER=edu_prod
MYSQL_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
MYSQL_DATABASE=edu
MYSQL_CHARSET=utf8mb4

# ---------- 向量库 Milvus ----------
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_DB=default

# ---------- MongoDB ----------
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=edu_agent

# ---------- MinIO（生产禁止 minioadmin/minioadmin） ----------
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=true
MINIO_ACCESS_KEY=<REPLACE_WITH_MINIO_USER>
MINIO_SECRET_KEY=<REPLACE_WITH_MINIO_PASSWORD>

# ---------- Neo4j（生产禁止默认密码） ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
NEO4J_DATABASE=neo4j

# ---------- LLM（生产用服务端 Key，禁止前端直连） ----------
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_STRONG=deepseek-v4-flash

# ---------- Embedding（独立向量服务） ----------
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 本地模型路径（无 GPU 可置空走 API 兜底） ----------
BGE_M3_PATH=
EMBED_DEVICE=cpu
RERANKER_PATH=
RERANKER_DEVICE=cpu

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---------- 路径 ----------
DATA_DIR=./data

#LOG_DIR=./logs
#LOG_ROTATION=100 MB
#LOG_RETENTION=7 days

# ============================================================
# 鉴权与安全（双 Token：access + refresh）
# ============================================================
# 【_security_guard 硬校验】DEBUG=false 时 JWT_SECRET/API_TOKEN 用公开默认值
#  → 直接拒绝启动（fail-fast）。生成强密钥：
#    python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
# ── C5-K2：JWT_SECRET 轮换窗口期旧密钥（可选）──
# 轮换流程：①启动服务先用旧密钥正常运行 ②生成新密钥写入 JWT_SECRET，旧密钥填到
# JWT_SECRET_PREVIOUS（旧 token 窗口期内仍可验）③窗口期结束后清空本字段作废旧密钥。
# 签发永远只用 JWT_SECRET。
#JWT_SECRET_PREVIOUS=

# ── C5-K3：500 错误上报 Webhook（可选）──
# 非 DEBUG 且设置时，全局兜底异常处理对 500 级异常 POST 精简载荷
# {trace_id, time, exception_type, stack(首2000字符)} 到该 URL（2s 超时，
# 失败静默不影响错误响应；DEBUG 一律不发）。响应契约零变更。
#ERROR_WEBHOOK_URL=
#JWT_ALGORITHM=HS256
#JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
#JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# ── C5-K4：refresh_token 轮换 allowlist（默认开）──
# 登录/刷新签发的 refresh_token 带 jti，Redis 存 rt:{user_id}:{jti}（TTL=refresh 有效期）；
# 刷新成功原子消费旧 jti、签发新 jti（轮换后旧 refresh 被拒，防重放）。
# Redis 降级 fail-open（跳过校验维持旧行为+降级日志）；false=回退轮换前行为。
#JWT_REFRESH_ROTATION_ENABLED=true
#JWT_EXPIRE_MINUTES=1440
#PASSWORD_HASH_ROUNDS=12
# 【_security_guard 硬校验】同上，生产必须替换默认值：
#    python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=REPLACE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE

# ── C5-K1：/metrics 抓取门禁（可选）──
# 留空 → /metrics 维持公开（向后兼容，启动打 WARN）；设置后 /metrics 要求
# Authorization: Bearer <METRICS_TOKEN>，Prometheus 抓取端配 bearer_token 同值。
#METRICS_TOKEN=

# ============================================================
# 检索参数（P2 调优 / task31 三段召回）
# ============================================================
#CHUNK_SIZE=512
#CHUNK_OVERLAP=64
#TOP_K_RECALL=20
#TOP_K_RERANK=5
#CLIFF_MIN_KEEP=3
#CLIFF_MAX_KEEP=8
#CLIFF_RATIO=0.4
#RETRIEVER_RECALL_TOPK=150
#RETRIEVER_RERANK_TOPK=20
#COURSE_PUBLIC_PARTITION=course_public
#RETRIEVER_EXCLUDE_CONTENT_TYPES=["promotion","schedule","announcement","marketing"]

# ============================================================
# 管理端 RAG rebuild 状态机（task04 #3/#8）
# ============================================================
#RAG_REBUILD_TIMEOUT_SECONDS=120

# ============================================================
# SQL 安全（P4 NL2SQL）
# ============================================================
#SQL_MAX_ROWS=1000
#SQL_TIMEOUT=30
#SQL_MAX_REPAIR=2


# ============================================================
# EduAgent 开发环境变量模板（本地开发参考，复制为 .env 后填写）
# 生产部署请用 .env.production.example
# ============================================================

# ---------- 应用 ----------
APP_NAME=EduAgent
APP_VERSION=0.3.0
DEBUG=true
# CORS 允许来源（逗号分隔）；留空时 DEBUG 开放全部 / 生产默认 localhost:3000
CORS_ORIGINS=

# ---------- MySQL（本地开发） ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_ME
MYSQL_DATABASE=edu
MYSQL_CHARSET=utf8mb4

# ---------- 向量库 Milvus ----------
MILVUS_URI=http://192.168.x.x:19530
MILVUS_TOKEN=
MILVUS_DB=default

# ---------- Redis 缓存 ----------
# 本地开发 Windows 用 Memurai（https://www.memurai.com/）或 WSL2 装 Redis
# 生产用 Redis Cluster / Sentinel
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ---------- MongoDB ----------
MONGO_URI=mongodb://192.168.x.x:27017
MONGO_DB=edu_agent

# ---------- MinIO ----------
MINIO_ENDPOINT=192.168.x.x:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---------- Neo4j ----------
NEO4J_URI=bolt://192.168.x.x:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_ME
NEO4J_DATABASE=neo4j

# ---------- 本地模型 ----------
BGE_M3_PATH=C:/ai-models/bge-m3
EMBED_DEVICE=cpu
RERANKER_PATH=C:/ai-models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# ---------- LLM（OpenAI 兼容 API） ----------
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_STRONG=deepseek-v4-flash

# ---------- Embedding（独立向量服务） ----------
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 鉴权（生产禁止默认值，详见 .env.production.example） ----------
JWT_SECRET=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_TOKEN=edu-agent-dev-token

# ---------- 日志 ----------
LOG_LEVEL=DEBUG
LOG_DIR=./logs

# ---------- 路径 ----------
DATA_DIR=./data
KNOWLEDGE_SOURCE_DIR=C:/Users/Administrator/Desktop/edu

# ---------- task-S1 全流程 HITL 护栏（灰度开关）----------
# 全局总开关：True=高风险写工具（exec_/run_/write_/http_/refund 等）执行前必过 HITL Gate，
# 未批准返回 SKIPPED 零执行。默认 False（安全）；灰度/测试窗口内显式开启。
HITL_ENABLED=False
# pending 超时自动拒绝窗口（秒），后台 sweep（task-S1-③）据此拒绝过期 pending
HITL_PENDING_TTL_S=600
# AI 审查子代理（仅测试窗口内开）
HITL_AI_REVIEW=False

# ============================================================
# EduAgent 统一环境变量模板（2026-09-16 实测：app/config.py Settings 243 字段 / 本模板 231 键，
# 其中未注释键 38；Settings 中 15 个新增字段尚未列入本模板，取 config.py 内置默认值）
# 契约真相源 = edu-agent/app/config.py（未列入本模板的字段以 config.py 默认值为准，禁改 contracts/*.json）
# 用法：复制为 .env 后填写（.env 已被 .gitignore 忽略，真实密钥零入库 — P5）
# ============================================================
#
# 【双形态对照】同一份模板，改 2 个键即可在 dev / prod 之间切换：
#
# ┌────────────────┬────────────────────────────┬──────────────────────────────┐
# │ 键             │ 形态 A：本机 dev            │ 形态 B：生产 prod（本模板默认）│
# ├────────────────┼────────────────────────────┼──────────────────────────────┤
# │ ENV_NAME       │ local                      │ prod / staging 等（非 local） │
# │ DEBUG          │ true                       │ false                        │
# │ JWT_SECRET     │ 可留默认（仅告警不阻断）     │ 必须强随机（_security_guard    │
# │                │                            │  硬校验，默认值直接拒启）      │
# │ API_TOKEN      │ 可留默认（仅告警不阻断）     │ 必须随机（同上硬校验）         │
# │ CORS_ORIGINS   │ 留空 → DEBUG 回退 "*"       │ 必配正式前端源（留空回退       │
# │                │                            │  http://localhost:3000）      │
# │ P1-8 门禁      │ DEBUG=true+ENV_NAME=local   │ DEBUG=true+ENV_NAME 非 local  │
# │                │ 放行                        │ → 拒绝启动（虚拟管理员后门）   │
# └────────────────┴────────────────────────────┴──────────────────────────────┘
#
# 【dev 形态切换方法】把下面两行改成：
#   ENV_NAME=local
#   DEBUG=true
# 其余键照常生效（MySQL/Redis 等本机默认值两形态通用）；注释掉的键取
# config.py 内置默认值，两形态一致。
#
# 【强密钥生成指引（P5 密钥零入库）】
#   JWT_SECRET：python -c "import secrets; print(secrets.token_hex(32))"
#   API_TOKEN ：python -c "import secrets; print(secrets.token_urlsafe(24))"
# 生成的密钥只写入 .env（git 忽略文件），严禁写进仓库内任何文件。
# ============================================================

# ============================================================
# 应用基础
# ============================================================
APP_NAME=EduAgent
APP_VERSION=0.3.0
# 生产推荐：false。DEBUG=true 存在虚拟管理员后门（未登录可读用户数据，P1-8）
DEBUG=false
# 环境名（H1b P1-8 门禁判据）：local=本机开发；prod=生产类环境
ENV_NAME=prod
# CORS 允许来源（逗号分隔完整源）。
#   生产占位示例：CORS_ORIGINS=https://edu.example.com,https://admin.example.com
#   本机同构一键拉起（taskC3 实证）：必须同时含 localhost 与 127.0.0.1 双源，否则按
#   127.0.0.1:3000 访问前端时所有 API 调用被 CORS 拦截（DEBUG 态 CORS=* 从未暴露）：
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#   留空时生产回退已含双源（app/main.py _cors_origins）；DEBUG 回退 "*"
CORS_ORIGINS=
# 服务监听（uvicorn 命令行 --port 会覆盖 PORT；生产可前置 Nginx 反代）
HOST=0.0.0.0
PORT=8000
WORKERS=1

# 平台自有 skill 根目录（EDUAGENT_PLATFORM_SKILL_ROOTS，os.pathsep 分隔多个根）
#   安全缺省：留空 = skill_node 只注入平台实物能力清单（permission_gate.TOOL_CLASS_MAP），
#   不注入任何平台自有 skill body；也绝不注入开发机 skill（list_directory/read_file 等）。
#   生产：若平台有自维护 skill 根，将其指向该目录（如：C:\platform\skills；类 Unix 用
#   /opt/edu/skills）；未配置则平台链路只靠 platform_capability_block 表述实物能力。
EDUAGENT_PLATFORM_SKILL_ROOTS=

# ============================================================
# MySQL（主库，本机/同构环境）
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# 必填（无默认值，缺失启动即失败）。生产用强密码，勿复用开发密码
MYSQL_PASSWORD=REPLACE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=edu
MYSQL_CHARSET=utf8mb4
# ---- 连接池（task04 #2 修复：防并发写连接占满全后端挂死） ----
#MYSQL_POOL_SIZE=10
#MYSQL_POOL_MAX_OVERFLOW=10
#MYSQL_POOL_RECYCLE=3600
#MYSQL_POOL_ACQUIRE_TIMEOUT=10.0
#MYSQL_POOL_ACQUIRE_RETRIES=2
# ---- 只读账号（P4 NL2SQL 兜底，生产建议独立低权限账号+强密码） ----
#MYSQL_RO_USER=edu_ro
#MYSQL_RO_PASSWORD=edu_ro_pwd_2026

# ============================================================
# Redis（缓存+限流+会话+队列；Windows 本机用 Memurai/WSL，生产 Cluster/Sentinel）
# ============================================================
# 教训：localhost 会被归一为 127.0.0.1（_normalize_loopback，避开 IPv6 建连超时）
REDIS_URL=redis://127.0.0.1:6379/0
#REDIS_MAX_CONNECTIONS=20
#REDIS_SOCKET_TIMEOUT=5.0
#REDIS_SOCKET_CONNECT_TIMEOUT=3.0
#REDIS_RETRY_ON_TIMEOUT=true
# ---- Schema 注册表（C2-③ 跨实例共享；无 Redis 环境可 false 纯本地） ----
#SCHEMA_REGISTRY_REDIS_ENABLED=true
#SCHEMA_REGISTRY_CACHE_TTL=30.0
#SCHEMA_REGISTRY_NAMESPACE=default
#SCHEMA_REGISTRY_KEY_PREFIX=edu:schema

# ============================================================
# Milvus（向量库，VM Docker）
# ============================================================
MILVUS_URI=http://192.168.85.101:19530
# 无认证留空；开启认证时用强 token
MILVUS_TOKEN=
#MILVUS_DB=default
#MILVUS_COLLECTION=edu_knowledge
#MILVUS_SEARCH_TIMEOUT=8.0

# ============================================================
# Neo4j（知识图谱；生产改强密码，docker 启动示例见 config.py 注释）
# ============================================================
NEO4J_URI=bolt://192.168.85.101:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_ME_NEO4J_PASSWORD
#NEO4J_DATABASE=neo4j
#NEO4J_CONNECT_TIMEOUT=3.0

# ============================================================
# jieba 自定义资源（相对 DATA_DIR=./data）
# ============================================================
#JIEBA_CUSTOM_DICT=custom_dict.txt
#JIEBA_STOPWORDS_FILE=stopwords.txt

# ============================================================
# MongoDB（对话状态，VM Docker）
# ============================================================
MONGO_URI=mongodb://192.168.85.101:27017
#MONGO_DB=edu_agent
#STATE_BACKEND=mongo

# ============================================================
# MinIO（对象存储；生产务必改默认 minioadmin/minioadmin + MINIO_SECURE=true）
# ============================================================
MINIO_ENDPOINT=192.168.85.101:9000
#MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=REPLACE_ME_MINIO_SECRET
#MINIO_BUCKET_COURSE=edu-course
#MINIO_BUCKET_QUESTION=edu-question
#MINIO_BUCKET_UPLOAD=edu-upload

# ============================================================
# 本地模型（BGE-M3 嵌入 / BGE-Reranker 重排）
# ============================================================
BGE_M3_PATH=C:/ai-models/bge-m3
EMBED_DEVICE=cuda
#EMBED_BATCH_SIZE=8
#EMBEDDING_DIM=1024
RERANKER_PATH=C:/ai-models/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
#RERANKER_BATCH_SIZE=16
#RERANKER_PRECISION=fp16

# ============================================================

LLM_API_KEY=REPLACE_ME_LLM_API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_STRONG=deepseek-v4-flash
#LLM_TEMPERATURE=0.0
#LLM_MAX_TOKENS=2000
# ---- FAST/STRONG 独立双源（留空回退 LLM_BASE_URL/LLM_API_KEY 同源） ----

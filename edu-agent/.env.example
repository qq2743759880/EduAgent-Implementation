# ============ LLM（OpenAI 兼容 API） ============
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=qwen-plus

# ============ Embedding 服务 ============
EMBEDDING_BACKEND=local_api
EMBEDDING_API_BASE=http://127.0.0.1:8001
EMBEDDING_DIM_DENSE=1024

# ============ Reranker 服务 ============
RERANKER_BACKEND=local_api
RERANKER_API_BASE=http://127.0.0.1:8002

# ============ Milvus ============
MILVUS_HOST=192.168.x.x
MILVUS_PORT=19530
MILVUS_COLLECTION=edu_knowledge

# ============ MongoDB ============
MONGO_URI=mongodb://192.168.x.x:27017
MONGO_DB=edu_agent

# ============ MySQL ============
MYSQL_URL=mysql+asyncmy://root:password@192.168.x.x:3306/edu_agent

# ============ 应用 ============
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=dev
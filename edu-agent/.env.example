# ============ LLM（OpenAI 兼容 API：a6api 中转 / DeepSeek 官方 / DashScope） ============
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://api.a6api.com/v1
LLM_MODEL_FAST=DeepSeek-V4-Flash-0731
LLM_MODEL_STRONG=DeepSeek-V4-Flash-0731

# ============ Embedding（独立，硅基流动 SiliconFlow） ============
# 聊天走 a6api/DeepSeek 时无 embeddings 端点，向量化必须显式指向硅基流动
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=BAAI/bge-m3

# ============ Reranker 服务 ============
RERANKER_BACKEND=local_api
RERANKER_API_BASE=http://127.0.0.1:8002

# ============ Milvus ============
MILVUS_HOST=192.168.x.x
MILVUS_PORT=19530
MILVUS_COLLECTION=edu_knowledge

# ============ MongoDB ============
MONGO_URI=mongodb://192.168.x.x:27017
MONGO_DB=edu_agent

# ============ MySQL ============
MYSQL_URL=mysql+asyncmy://root:password@192.168.x.x:3306/edu_agent

# ============ 应用 ============
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=dev
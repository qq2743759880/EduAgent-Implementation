      "width": 132,
      "height": 76
    }
  ],
  "edges": [
    {
      "id": "w0",
      "from": "source",
      "to": "play",
      "label": "授权 / 校验",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "w1",
      "from": "play",
      "to": "transcript",
      "label": "派生生产",
      "role": "branch",
      "variant": "default",
      "fromSide": "left",
      "toSide": "top"
    },
    {
      "id": "w2",
      "from": "transcript",
      "to": "compile",
      "label": "转写成功",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "w3",
      "from": "compile",
      "to": "artifact",
      "label": "校验 / 封存",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "w4",
      "from": "artifact",
      "to": "pending",
      "label": "当前版本授权",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "w5",
      "from": "pending",
      "to": "ingest",
      "label": "向量 active 仍非正式",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "w6",
      "from": "ingest",
      "to": "ready",
      "label": "回执 PASS 后激活",
      "role": "main",
      "variant": "default",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "w7",
      "from": "ready",
      "to": "learn",
      "label": "正式版本",
      "role": "return",
      "variant": "default",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "w8",
      "from": "compile",
      "to": "failed",
      "label": "编译失败",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "w9",
      "from": "ingest",
      "to": "failed",
      "label": "入库 / 激活失败",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "w10",
      "from": "failed",
      "to": "retry",
      "label": "安全恢复",
      "role": "branch",
      "variant": "default"
    },
    {
      "id": "w11",
      "from": "retry",
      "to": "ingest",
      "label": "仅入库失败时重试",
      "role": "return",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "正式版本权威",
      "items": [
        "只有 READY publication 允许学生读取和精确检索视频知识。",
        "没有旧 READY 时，Pending / Failed 的 AI 资料不可用。"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复边界",
      "items": [
        "编译失败重试编译阶段；上图入库重试只适用于已封存产物。",
        "失败不能禁用原视频，也不能把新版替换为旧页面批准。"
      ]
    }
  ]
}
      "width": 132,
      "height": 76
    },
    {
      "id": "ingest",
      "lane": "production",
      "col": 4,
      "type": "backend",
      "label": "既有 RAG 入库",
      "sublabel": "回执校验",
      "width": 132,
      "height": 76
    },
    {
      "id": "ready",
      "lane": "student",
      "col": 3,
      "type": "security",
      "label": "READY 激活",
      "sublabel": "精确版本正式可见",
      "width": 132,
      "height": 76
    },
    {
      "id": "learn",
      "lane": "student",
      "col": 4,
      "type": "frontend",
      "label": "学生学习 / Tutor",
      "sublabel": "资料与时间引用",
      "width": 132,
      "height": 76
    },
    {
      "id": "failed",
      "lane": "failure",
      "col": 1,
      "type": "security",
      "label": "失败 / 未就绪",

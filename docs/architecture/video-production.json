      "width": 132,
      "height": 76
    },
    {
      "id": "play",
      "lane": "teacher",
      "col": 1,
      "type": "cloud",
      "label": "独立播放源",
      "sublabel": "原视频先绑定",
      "width": 132,
      "height": 76
    },
    {
      "id": "transcript",
      "lane": "production",
      "col": 0,
      "type": "backend",
      "label": "字幕 / ASR",

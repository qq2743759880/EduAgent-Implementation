    "output": "docs/architecture/video-production.html",
    "quality_profile": "showcase",
    "locale": "zh-CN"
  },
  "lanes": [
    {
      "id": "teacher",
      "label": "管理员 / 播放"
    },
    {
      "id": "production",
      "label": "派生资料生产"
    },
    {
      "id": "student",
      "label": "正式学生能力"
    },
    {
      "id": "failure",
      "label": "失败与恢复",
      "variant": "exception"
    }
  ],
  "nodes": [
    {
      "id": "source",
      "lane": "teacher",
      "col": 0,
      "type": "frontend",

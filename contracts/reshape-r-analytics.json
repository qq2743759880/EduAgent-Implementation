  "event_stream_schema": {
    "collection": "learning_event",
    "doc": {
      "user_id": "int",
      "type": "video_heartbeat|quiz_submit|session_complete",
      "payload": "object",
      "ts": "datetime(服务器本地，与 MySQL NOW() 同口径)",
      "session_id": "int|null"
    },
    "indexes": [
      "uid_ts(user_id,ts desc)",
      "type_ts(type,ts desc)",
      "ts_1 TTL=MONGO_EVENT_TTL_DAYS(默认90d，collMod 热更，0=不过期)"
    ],
    "switches": [
      "MONGO_EVENT_ENABLED(默认True)",
      "MONGO_EVENT_TTL_DAYS",
      "MONGO_EVENT_QUEUE_MAXSIZE",
      "MONGO_EVENT_MAX_RETRY",
      "MONGO_EVENT_BREAKER_FAILURES",
      "MONGO_EVENT_BREAKER_OPEN_S"
    ],
    "degradation": "mongo 断连 → 旁路停写（熔断 OPEN→half_open 自愈），主链 MySQL 事务零改动无感；写失败 WARN 不阻断"
  },
  "ts_tz_note": "ts 采用服务器本地 naive datetime 与 MySQL NOW() 同口径（对账窗口直接可比）；TTL 按 mongo UTC 解释存在时区偏移，对 90d 级 TTL 语义无害（已登记，冻结时可选统一 UTC）"
}
